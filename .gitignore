cat > .gitignore <<'EOF'
# Frontend
frontend/node_modules/
frontend/.cache/
frontend/dist/
frontend/build/

# Backend
backend/venv/
backend/__pycache__/
backend/*.pyc

# Environment files
.env
.env.*
backend/.env
frontend/.env
frontend/.env.*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# Build/cache
.cache/
dist/
build/

# OS / editor
.DS_Store
.vscode/
*.log
EOF